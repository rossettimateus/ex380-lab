# Copie para lab.env e preencha os valores do SEU ambiente. Não publique lab.env.
LAB_API=https://api.SEÚ-CLUSTER:6443
LAB_NODE=SEU-WORKER-RHCOS
HTTP_BASE=https://raw.githubusercontent.com/rossettimateus/ex380-lab/main
# Repo de escrita dos seus manifests; não é necessário copiar o kit.
REPO_URL=https://github.com/SEU-USUARIO/ex380-meus-manifests.git
LAB_USER=SEU-USUARIO-OAUTH
# Opcional: usuário OAuth real fora de gitops-admins, para teste negativo.
LAB_NEGATIVE_USER=SEU-USUARIO-NEGATIVO
# Preencha com o SHA completo do SEU commit FINAL após resolver a prova.
EXPECTED_REVISION=
